# ─── Notion (feedback wall) ────────────────────────────────────────────────
# 1. Create an internal integration: https://www.notion.so/my-integrations
#    Copy its "Internal Integration Secret" into NOTION_TOKEN.
# 2. Create a database with these properties (names must match exactly):
#      Message   — Title
#      Name      — Text
#      Approved  — Checkbox
# 3. Open the database → ••• → Connections → add your integration.
# 4. Copy the database id from its URL:
#      notion.so/<workspace>/<DATABASE_ID>?v=...
NOTION_TOKEN=
NOTION_FEEDBACK_DATABASE_ID=

# Set to "true" to hide notes until you tick Approved in Notion.
# Leave blank/false and every submitted note appears on the wall immediately.
NOTION_FEEDBACK_REQUIRE_APPROVAL=

# Lets you purge the feedback cache after editing Notion, instead of waiting
# for the 60s window:  curl "<site>/api/revalidate-feedback?secret=..."
# Use any long random string.
FEEDBACK_REVALIDATE_SECRET=

# ─── Notion (support inbox) ────────────────────────────────────────────────
# Messages from /support. Uses the same NOTION_TOKEN; create a second database
# with these properties (names must match exactly) and connect the integration:
#      Subject  — Title
#      Name     — Text
#      Email    — Email
#      Topic    — Select   (options are added automatically)
#      Device   — Text
#      Message  — Text
# Without it the form is disabled and points visitors to the email address.
NOTION_SUPPORT_DATABASE_ID=
